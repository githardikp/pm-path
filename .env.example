# Optional: switch on sign-in and cross-device sync with a free Firebase project.
# Copy this file to .env.local and fill in the values from
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
# These are public identifiers, not secrets. Leave them empty to run PM Path without sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
